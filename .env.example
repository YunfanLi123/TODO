# 内测版：部署平台的“环境变量”中填写，绝不提交 .env。
BETA_AUTH=1
BETA_SESSION_SECRET=replace-with-a-long-random-secret
BETA_INVITE_CODE=replace-with-your-private-invite-code
# 可修改全局模型/规则配置的运营邮箱（逗号分隔），普通内测用户没有该权限。
BETA_ADMIN_EMAILS=owner@example.com
# 线上必须走 HTTPS；本地调试可留空。
BETA_HTTPS=1
# PostgreSQL 示例；留空才会使用本地 SQLite（不适合云端）。
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# 容器内运行期目录；录像应在后续接入对象存储后迁出该目录。
MATCH_DATA_DIR=/app/data
