{
  "_说明": "探测器规格（**标定值**）。改阈值改这里，识别代码不动。",
  "_三态": "found=看到了证据；absent=信号可读但明确没有（只有强探测器能给）；unknown=读不出来。只有 absent 才允许判「该做而没做」。",
  "_档位": "本轮只做小地图几何类（Tier A）。需要小兵血条/战斗画面的那一类（补刀、开团、集火、撤退）没有探测器 → 永远 unknown → 判「无法判定」。",
  "_区域名": "必须与 app/collection/map_geometry.json 的区域名一致：己方野区 / 敌方野区 / 泉水 / 己方高地 / 敌方高地 / 主宰坑 / 暴君坑",
  "版本": 1,
  "规格": {
    "objective_action:farm_jungle": {
      "说明": "在己方野区来回折返（打小野怪）",
      "强": true,
      "允许判没做": true,
      "参数": {
        "野区": "己方野区",
        "野区占比下限": 0.30,
        "折返率下限": 0.20,
        "直线性上限": 0.60
      }
    },
    "objective_action:invade_jungle": {
      "说明": "跑到敌方野区偷野",
      "强": false,
      "允许判没做": false,
      "参数": {
        "野区": "敌方野区",
        "野区占比下限": 0.22,
        "折返率下限": 0.15,
        "直线性上限": 0.60
      }
    },
    "objective_action:take_dragon": {
      "说明": "拿下小龙（暴君）—— 要在坑里待够，而且龙图标消失",
      "强": false,
      "允许判没做": false,
      "参数": {
        "龙坑": "暴君",
        "停留秒数下限": 8,
        "需要图标消失": true
      }
    },
    "objective_action:contest_dragon": {
      "说明": "开小龙团（在暴君坑参与争夺）",
      "强": true,
      "允许判没做": true,
      "参数": {
        "龙坑": "暴君",
        "停留秒数下限": 8
      }
    },
    "objective_action:fight_baron": {
      "说明": "开大龙团（主宰坑）",
      "强": true,
      "允许判没做": true,
      "参数": {
        "龙坑": "主宰",
        "停留秒数下限": 8
      }
    },
    "objective_action:recall": {
      "说明": "回城补给（回到泉水）",
      "强": true,
      "允许判没做": true,
      "参数": {
        "区域": "泉水",
        "停留秒数下限": 6
      }
    },
    "objective_action:siege": {
      "说明": "拆敌方高地",
      "强": true,
      "允许判没做": true,
      "参数": {
        "区域": "敌方高地",
        "停留秒数下限": 10
      }
    },
    "objective_action:defend_inner": {
      "说明": "回防己方高地",
      "强": true,
      "允许判没做": true,
      "参数": {
        "区域": "己方高地",
        "停留秒数下限": 10
      }
    },
    "positioning_action:rotate_support": {
      "说明": "转线支援（跨区直穿）",
      "强": true,
      "允许判没做": true,
      "参数": {
        "净位移下限": 0.22,
        "路径净位移比上限": 0.65
      }
    },
    "positioning_action:push_wave": {
      "说明": "推线压塔（沿边路单向推进）",
      "强": true,
      "允许判没做": true,
      "参数": {
        "直线性下限": 0.65,
        "净位移下限": 0.10,
        "边路占比下限": 0.45,
        "时长下限秒": 0
      }
    },
    "objective_action:split_push": {
      "说明": "分推牵制（一侧边路长时间单向推进）",
      "强": false,
      "允许判没做": false,
      "参数": {
        "直线性下限": 0.70,
        "净位移下限": 0.15,
        "边路占比下限": 0.60,
        "时长下限秒": 90
      }
    },
    "positioning_action:hold_position": {
      "说明": "卡位蹲伏（整段基本不动，且不在泉水）",
      "强": false,
      "允许判没做": false,
      "参数": {
        "净位移上限": 0.05,
        "总路程上限": 0.10
      }
    }
  }
}
